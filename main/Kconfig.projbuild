choice PLANTHUB_DEFAULT_RADIO_ROLE
    prompt "Default radio role (fallback when NVS radio_role unset)"
    default PLANTHUB_RADIO_ROLE_BLE
    help
        One universal image, one radio per node chosen at runtime. Both the
        BLE and Zigbee stacks are compiled in; this selects which one STARTS
        when NVS has no radio_role yet. The config UI will write radio_role
        (a reboot applies it); this is only the first-boot fallback.

config PLANTHUB_RADIO_ROLE_WIFI_ONLY
    bool "wifi_only (neither BLE nor Zigbee)"
config PLANTHUB_RADIO_ROLE_BLE
    bool "ble"
config PLANTHUB_RADIO_ROLE_ZIGBEE
    bool "zigbee"
endchoice
